# Formspree backs the demo request form on /contact.
#
# Neither variable is required. The form ID is committed in
# src/lib/formspree.ts because Formspree IDs are public by design, so the form
# works from a clean clone with no setup.
#
# Override the ID only to point a staging deploy at a different Formspree form:
# NEXT_PUBLIC_FORMSPREE_FORM_ID=xxxxxxxx
#
# Override the endpoint only to aim submissions at a local stub in tests:
# NEXT_PUBLIC_FORMSPREE_ENDPOINT=http://localhost:4455/f/test

# Umami analytics. Optional: with no website id, no script is loaded at all.
#
# Both are public by design. The script runs in the visitor's browser and the
# id travels with every request, so neither is a secret. Because this is a
# static export they are baked in at build time, which means they must also be
# set in the GitHub Actions workflow, not only here.
#
# Umami Cloud: copy the Website ID from Settings > Websites.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
#
# Only needed if you self-host. Defaults to Umami Cloud.
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://analytics.yourdomain.com/script.js
