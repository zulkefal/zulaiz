# Formspree backs the demo request form on /contact.
#
# Neither variable is required. The form ID is committed in
# src/lib/formspree.ts because Formspree IDs are public by design, so the form
# works from a clean clone with no setup.
#
# Override the ID only to point a staging deploy at a different Formspree form:
# NEXT_PUBLIC_FORMSPREE_FORM_ID=xxxxxxxx
#
# Override the endpoint only to aim submissions at a local stub in tests:
# NEXT_PUBLIC_FORMSPREE_ENDPOINT=http://localhost:4455/f/test
